# ═══════════════════════════════════════════════════════════════════════════════
#  GUILDED — Production Environment Variables
#  Copy to .env and fill in all values. Never commit .env to git.
#  Run the app once and check the startup log — missing vars are warned clearly.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# FastAPI requires postgresql+asyncpg:// driver prefix
DATABASE_URL="postgresql+asyncpg://guilded:guilded@localhost:5432/guilded"
# Dev SQLite (not recommended for production):
# DATABASE_URL="sqlite+aiosqlite:///./dev.db"

# ── FastAPI / Auth ────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY="change-me-in-production"
DEBUG=false

# ── NextAuth (Next.js) ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="https://your-domain.com"

# API base URL for the frontend (no trailing slash)
NEXT_PUBLIC_API_URL="https://api.your-domain.com"

# ── Stripe Billing ────────────────────────────────────────────────────────────
# STRIPE_MODE: "test" (dev/beta) or "live" (real money).
# The API validates key/mode consistency at startup.
# See STRIPE_LIVE_CUTOVER.md before switching to live.
STRIPE_MODE="test"

# Active credentials — match your STRIPE_MODE:
STRIPE_SECRET_KEY="sk_test_..."    # test: sk_test_...  /  live: sk_live_...
STRIPE_WEBHOOK_SECRET="whsec_..."  # Stripe signing secret for this mode

# ── Stripe price IDs (dual-environment) ──────────────────────────────────────
# Test mode prices (create in Stripe test Dashboard → Products):
STRIPE_TEST_JOURNEYMAN_PRICE_ID="price_test_..."
STRIPE_TEST_MASTER_PRICE_ID="price_test_..."

# Live mode prices — Guilded live products (2026):
#   JOURNEYMAN: prod_UTsZYlIpw87Nmv  | price_1TUuobKKUUjkHBcxFAqKggtu
#   MASTER:     prod_UTsffumfGfsBBx  | price_1TUuuWKKUUjkHBcxhabmw62I
STRIPE_LIVE_JOURNEYMAN_PRICE_ID="price_1TUuobKKUUjkHBcxFAqKggtu"
STRIPE_LIVE_MASTER_PRICE_ID="price_1TUuuWKKUUjkHBcxhabmw62I"

# ── Founders Pass price IDs (one-time payments) ──────────────────────────────
# Create as one-time prices in Stripe Dashboard → Products.
# STANDARD: $195 · PARTNER: $97
STRIPE_TEST_FOUNDERS_STANDARD_PRICE_ID="price_test_founders_standard_..."
STRIPE_TEST_FOUNDERS_PARTNER_PRICE_ID="price_test_founders_partner_..."
STRIPE_LIVE_FOUNDERS_STANDARD_PRICE_ID=""
STRIPE_LIVE_FOUNDERS_PARTNER_PRICE_ID=""

# ── Fair use monitoring (architecture only — not enforced until FAIR_USE_ENABLED=true) ──
# FAIR_USE_ENABLED=false
# FAIR_USE_AI_DAILY_MAX=500
# FAIR_USE_OCR_DAILY_MAX=50

# ── Live mode cutover (uncomment ALL FOUR simultaneously when going live) ─────
# STRIPE_MODE="live"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_live_..."
# (STRIPE_LIVE_*_PRICE_IDs above are already set — just flip STRIPE_MODE)

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ── Email — Resend (https://resend.com) ───────────────────────────────────────
# Without RESEND_API_KEY, emails are logged to console only (safe default for dev).
# Install: pip install resend==2.0.0
#
# Verified sending domain: mail.jesseboudreau.com
# Default EMAIL_FROM is already set to the verified address in code.
# Override here only if you need a different verified sender.
RESEND_API_KEY="re_..."
EMAIL_FROM="Guilded <guilded@mail.jesseboudreau.com>"
# EMAIL_REPLY_TO="guilded@jesseboudreau.com"

# ── Analytics — PostHog (https://posthog.com) ─────────────────────────────────
# Copy your Project API Key from PostHog → Settings → Project API Key
# When set, all analytics.ts events automatically forward to PostHog
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── Error Monitoring — Sentry ─────────────────────────────────────────────────
# Setup: npx @sentry/wizard@latest -i nextjs
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@o0.ingest.sentry.io/0"

# ── Aegis Governance Layer ─────────────────────────────────────────────────────
# Guilded is a governed application in the Aegis ecosystem.
# Without these vars, all governance decisions fall back to local tier logic.
# With them, entitlements and AI limits are governed centrally by Aegis.
#
# AEGIS_URL            — Aegis API base URL
# AEGIS_SERVICE_KEY    — HMAC-SHA256 signing key (generated by Aegis for Guilded)
# AEGIS_TIMEOUT        — seconds to wait before falling back to local (default: 3.0)
# AEGIS_FALLBACK       — allow local decisions when Aegis is unreachable (default: true)
AEGIS_URL="https://aegis.jesseboudreau.com"
AEGIS_SERVICE_KEY="your-guilded-service-key-from-aegis"

# ── Beta Access Control ────────────────────────────────────────────────────────
# Set to true to require an invite code during registration.
# Generate codes via: POST /api/admin/invite-codes
# BETA_INVITE_REQUIRED=false
#
# Set this to match above on the frontend:
# NEXT_PUBLIC_BETA_INVITE_REQUIRED=false
# AEGIS_TIMEOUT=3.0
# AEGIS_FALLBACK_ENABLED=true
