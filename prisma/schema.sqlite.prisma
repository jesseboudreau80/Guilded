// SQLite variant for local development without a PostgreSQL instance.
// Usage: see README.md "Local Dev (SQLite)" section.
//
// Key differences from schema.prisma:
//   - provider = "sqlite"
//   - Enums are stored as strings (Prisma handles this transparently)
//   - Use `prisma db push --schema prisma/schema.sqlite.prisma` (not migrate)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Prisma maps enums to String in SQLite. The generated client exposes the same
// Tier / SubscriptionStatus types regardless of provider.

model User {
  id                     String   @id @default(cuid())
  name                   String?
  email                  String?  @unique
  emailVerified          DateTime?
  image                  String?
  passwordHash           String?
  tier                   String   @default("APPRENTICE")
  subscriptionStatus     String   @default("INACTIVE")
  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  subscriptionStartDate  DateTime?
  successfulBillingCount Int      @default(0)
  aiUsageCount           Int      @default(0)
  aiUsageResetDate       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  consultations Consultation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Module {
  id           String   @id @default(cuid())
  title        String
  requiredTier String   @default("APPRENTICE")
  order        Int
  lessons      Lesson[]
}

model Lesson {
  id       String     @id @default(cuid())
  moduleId String
  title    String
  content  String
  order    Int
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress Progress[]
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Consultation {
  id             String    @id @default(cuid())
  userId         String
  tierAtPurchase String
  pricePaid      Int
  discounted     Boolean   @default(false)
  scheduledDate  DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
